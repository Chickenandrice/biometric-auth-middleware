# BioAuth backend
# Transport: "simulate" (no hardware), "http" (Pi over HTTP), "bluetooth" (Pi over BLE)
BIOAUTH_TRANSPORT_MODE=simulate
# BIOAUTH_EDGE_HTTP_URL=http://localhost:8001
# BIOAUTH_EDGE_BLUETOOTH_ADDRESS=XX:XX:XX:XX:XX:XX

# Auth0 — Application type must be "Single Page Application"
# In Auth0 Dashboard → Applications → Settings, add to Callback, Logout, and Web Origins the EXACT
# origin you use in the browser (http://127.0.0.1:9000 vs http://localhost:9000 are different).
# OAuth callback for the demo (must match Allowed Callback URLs exactly):
# AUTH0_REDIRECT_URI=http://127.0.0.1:9000/landing-page
AUTH0_DOMAIN=YOUR_AUTH0_DOMAIN
AUTH0_CLIENT_ID=YOUR_AUTH0_CLIENT_ID

# Nuke demo (:9000) — gateway the SDK and linked dashboard use (defaults match dev gateway)
# BIOAUTH_GATEWAY_URL=http://localhost:8000
# BIOAUTH_GATEWAY_API_KEY=dev-api-key-001